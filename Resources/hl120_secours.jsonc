{
	"name": "Leclerc SXXI HL 120 secours",
	"fov": 5,
	"units": "mil_nato",
	"lights": {"from_host": true, "set": {"NightIllumination": [2.4, 0.5, 0.12]}},
	"style": {"w": 0.11, "visual": "painted"},
	"vars": {
		"Round": 0,
		"Far": "Round == 0 ? 4000 : Round == 2 ? 2800 : 3600",
		"Near": "Round == 0 ? 1000 : 800",
		"Step": "Round == 0 ? 500 : 200",
		"Major": "Round == 0 ? 1000 : 400"
	},
	"defs": {
		"Row": {
			"params": ["r"],
			"elements": [
				{
					"group": "{r} m",
					"at": [0, "r"],
					"elements": [
						{
							"if": "r % Major == 0",
							"then": [
								{"poly": [[-0.6, -0.6], [0, 0], [0.6, -0.6]]},
								{"seg": [-9, 0, -2.4, 0]},
								{"seg": [2.4, 0, 3.2, 0]},
								{"text": "{r / 100}", "at": [4.4, 0], "size": 7}
							],
							"else": [{"seg": [-0.45, 0, 0.45, 0]}, {"seg": [-4.6, 0, -2.4, 0]}]
						}
					]
				}
			]
		},
		"Scale": {
			"params": ["key"],
			"elements": [
				{
					"group": "Hausse",
					"ballistic": "{key}",
					"elements": [{"for": "r", "in": "Near .. Far step Step", "do": [{"use": "Row", "args": {"r": "r"}}]}]
				}
			]
		}
	},
	"elements": [
		{
			"group": "Ligne de visée",
			"align": "Boresight",
			"elements": [
				{"poly": [[-1.5, -1.5], [0, 0], [1.5, -1.5]], "w": 0.15},
				{"seg": [-22, 0, -3.5, 0], "w": 0.24},
				{"seg": [3.5, 0, 22, 0], "w": 0.24},
				{
					"for": "s",
					"in": [-1, 1],
					"do": [
						{
							"for": "m",
							"in": [5, 10, 15, 20],
							"do": [
								{"seg": ["s * m", 0, "s * m", "m % 10 == 0 ? 1.6 : 0.9"]},
								{"if": "m % 10 == 0", "then": [{"text": "{m}", "at": ["s * m", 2.7], "size": 6}]}
							]
						}
					]
				},
				{"text": "#ROUND", "at": [0, 7.4], "size": 8},
				{"text": "SECOURS  -  HM", "at": [0, 5.4], "size": 6},
				{"if": "Round == 0", "then": [{"use": "Scale", "args": {"key": "'ofl'"}}]},
				{"if": "Round == 1", "then": [{"use": "Scale", "args": {"key": "'oecc'"}}]},
				{"if": "Round == 2", "then": [{"use": "Scale", "args": {"key": "'expl'"}}]}
			]
		}
	]
}
