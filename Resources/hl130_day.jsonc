{"name":"Leclerc SXXI HL 130 day","fov":3.1,"lights":{"from_host":true},"style":{"w":0.105,"visual":"painted"},"vars":{"ScaleZero":-3.55},"defs":{"Scale":{"params":["ammo","label","x","side","ranges","major"],"elements":[{"group":"{label} scale","at":["x","ScaleZero"],"elements":[{"text":"{label}","at":["side * 1.25",1.18],"size":8},{"group":"","ballistic":"{ammo}","elements":[{"for":"r","in":"ranges","do":[{"group":"{r} m","at":[0,"r"],"elements":[{"seg":[0,0,"side * (major(r) ? 1.36 : 0.68)",0]},{"if":"major(r)","then":[{"text":"{r / 100}","at":["side * 2.12",0],"size":8}]}]}]}]}]}]}},"elements":[{"group":"Line of sight","align":"Boresight","elements":[{"seg":[-2.1,0,2.1,0],"w":0.17},{"seg":[0,-2.42,0,2.05],"w":0.17},{"for":"x","in":[-9.05,-5.15,5.15,9.05],"do":[{"line":["x",0,0,2.1]}]},{"seg":[-0.5,"ScaleZero",0.5,"ScaleZero"]},{"for":"i","in":"1 .. 4","do":[{"line":[0,"ScaleZero - i * 2.5",90,1.1]}]},{"use":"Scale","args":{"ammo":"'expl'","label":"'EXPL'","x":-7.35,"side":-1,"ranges":"800 .. 2000 step 200","major":"r => r % 400 == 0"}},{"use":"Scale","args":{"ammo":"'oecc'","label":"'OECC'","x":7.35,"side":1,"ranges":"800 .. 2400 step 200","major":"r => r % 400 == 0"}},{"use":"Scale","args":{"ammo":"'ofl'","label":"'OFL'","x":2.52,"side":1,"ranges":"1000 .. 3000 step 500","major":"r => r % 1000 == 0"}},{"group":"OFL offset rows","at":[0,"ScaleZero"],"elements":[{"group":"","ballistic":"ofl","elements":[{"for":"r","in":[1000,2000,3000],"do":[{"group":"{r} m","at":[0,"r"],"elements":[{"for":"i","in":"1 .. 4","do":[{"line":["-1.5 * i",0,0,0.17],"w":0.17}]}]}]}]}]}]},{"group":"Range index","align":"Impact","elements":[{"circle":[0,"ScaleZero",0.35],"w":0.075},{"seg":[-1.02,"ScaleZero",-0.35,"ScaleZero"]},{"seg":[0.35,"ScaleZero",1.02,"ScaleZero"]}]}]}