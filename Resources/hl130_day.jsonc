{
	"name": "Leclerc SXXI HL 130 day",
	"fov": 3.1,
	"units": "mil_nato",
	"lights": {"from_host": true},
	"style": {"w": 0.07, "visual": "painted"},
	"vars": {
		"StadiaS": 6.0,
		"StadiaY": "r => 0.8857 + 4.7429 * r - 0.2143 * r * r + 0.3857 * r * r * r",
		"StadiaSteps": "0 .. 51",
		"StadiaR": "i => 0.51 + i * 0.05",
		"Zero127": -0.5,
		"ZeroOecc": 1.06,
		"ZeroOfl": -0.87,
		"LabelY": -2.4,
		"HullX": 0.4,
		"HullY": -15.4,
		"HullH": 1.9
	},
	"defs": {
		"Scale": {
			"params": ["name", "ammo", "zero", "ranges", "major", "minor", "long", "labelX"],
			"elements": [
				{
					"group": "{name} scale",
					"at": [0, "zero"],
					"elements": [
						{
							"group": "{name} rows",
							"ballistic": "{ammo}",
							"elements": [
								{
									"for": "r",
									"in": "ranges",
									"do": [
										{
											"group": "{name} {r} m",
											"at": [0, "-r"],
											"elements": [
												{
													"if": "major(r)",
													"then": [
														{"seg": ["long[0]", 0, "long[1]", 0]},
														{"text": "{r / 100}", "at": ["labelX", 0], "size": 8}
													],
													"else": [{"seg": ["minor[0]", 0, "minor[1]", 0], "w": 0.06}]
												}
											]
										}
									]
								}
							]
						}
					]
				}
			]
		},
		"Index": {
			"params": ["x", "y", "s"],
			"elements": [{"poly": [["x + s * 1.2", "y + 0.5"], ["x", "y"], ["x + s * 1.2", "y - 0.5"]]}]
		}
	},
	"elements": [
		{
			"group": "Nominal cross",
			"align": "Boresight",
			"elements": [
				{"seg": [-0.9, 0, 0.9, 0]},
				{"seg": [0, -0.9, 0, 0.9]},
				{
					"for": "s",
					"in": [-1, 1],
					"do": [
						{"seg": ["s * 0.9", 0.085, "s * 3", 0.085]},
						{"seg": ["s * 0.9", -0.085, "s * 3", -0.085]},
						{"seg": [0.085, "s * 0.9", 0.085, "s * 3"]},
						{"seg": [-0.085, "s * 0.9", -0.085, "s * 3"]},
						{
							"for": "m",
							"in": [4, 6, 7, 8, 9, 10],
							"do": [{"seg": ["s * m - 0.06", 0, "s * m + 0.06", 0], "w": 0.12}]
						},
						{"poly": [["s * 5 - 0.16", 0.05], ["s * 5", 0.4], ["s * 5 + 0.16", 0.05]], "w": 0.06}
					]
				}
			]
		},
		{
			"group": "Plate",
			"align": "Impact",
			"elements": [
				{"seg": [-12, 0, -1.5, 0]},
				{"seg": [-1, 0, -0.2, 0]},
				{"seg": [0.2, 0, 1, 0]},
				{"seg": [1.5, 0, 12, 0]},
				{
					"for": "s",
					"in": [-1, 1],
					"do": [
						{"for": "m", "in": [3, 5, 7, 9, 11], "do": [{"seg": ["s * m", 0, "s * m", 0.65]}]},
						{
							"for": "m",
							"in": [2, 4, 6, 8, 10],
							"do": [{"seg": ["s * m", 0, "s * m", -0.85]}, {"text": "{m}", "at": ["s * m", -2.1], "size": 8}]
						},
						{"seg": ["s * 12", 0.3, "s * 12", -0.95]},
						{"text": "12", "at": ["s * 12", -2.1], "size": 8}
					]
				},
				{"seg": [0, 0, 0, 0.8]},
				{"seg": [0, 0, -0.45, -0.95]},
				{"seg": [0, 0, 0.45, -0.95]},
				{
					"for": "s",
					"in": [-1, 1],
					"do": [
						{
							"for": "i",
							"in": "StadiaSteps",
							"do": [
								{
									"seg": [
										"s * StadiaS / 2 / StadiaR(i)",
										"StadiaY(StadiaR(i))",
										"s * StadiaS / 2 / StadiaR(i + 1)",
										"StadiaY(StadiaR(i + 1))"
									],
									"w": 0.06
								}
							]
						}
					]
				},
				{
					"for": "r",
					"in": [1, 2, 3],
					"do": [
						{"seg": [-0.5, "StadiaY(r)", 0.5, "StadiaY(r)"], "w": 0.06},
						{"text": "{r * 10}", "at": [0, "StadiaY(r) + 0.75"], "size": 8}
					]
				},
				{
					"use": "Scale",
					"args": {
						"name": "'12.7'",
						"ammo": "'m2'",
						"zero": "Zero127",
						"ranges": "0 .. 2000 step 100",
						"major": "r => r % 500 == 0",
						"minor": [-32.3, -30.6],
						"long": [-34.5, -30.2],
						"labelX": -35.7
					}
				},
				{
					"use": "Scale",
					"args": {
						"name": "'OECC'",
						"ammo": "'oecc'",
						"zero": "ZeroOecc",
						"ranges": "0 .. 3000 step 100",
						"major": "r => r % 500 == 0",
						"minor": [-21.4, -19.7],
						"long": [-23.3, -19.3],
						"labelX": -24.6
					}
				},
				{
					"use": "Scale",
					"args": {
						"name": "'OFL'",
						"ammo": "'ofl'",
						"zero": "ZeroOfl",
						"ranges": "0 .. 4000 step 200",
						"major": "r => r % 1000 == 0",
						"minor": [20.3, 22.4],
						"long": [20.3, 24.4],
						"labelX": 25.8
					}
				},
				{"text": "12.7", "at": [-34, "LabelY"], "size": 8},
				{"text": "OECC", "at": [-22.1, "LabelY"], "size": 8},
				{"text": "OFL", "at": [23.1, "LabelY"], "size": 8},
				{"use": "Index", "args": {"x": -29.9, "y": "Zero127", "s": 1}},
				{"use": "Index", "args": {"x": -18.7, "y": "ZeroOecc", "s": 1}},
				{"use": "Index", "args": {"x": 19.6, "y": "ZeroOfl", "s": -1}},
				{
					"for": "y",
					"in": "-2 .. 2 step 0.5",
					"do": [{"seg": [35.9, "y", "y % 2 == 0 ? 39.1 : 38.4", "y"], "w": 0.06}]
				},
				{"text": "2", "at": [39.9, 2], "size": 7},
				{"text": "0", "at": [39.9, 0], "size": 7},
				{"text": "2", "at": [39.9, -2], "size": 7},
				{"use": "Index", "args": {"x": 35.2, "y": 0, "s": -1}}
			]
		}
	],
	"screen": {
		"name": "HL 130 day display",
		"items": [
			{"rect": "box", "at": [0.54, -14.04], "size": [19.93, 8.84], "color": [0.035, 0.03, 0.025, 0.93]},
			{
				"readout": "range",
				"at": [-5.6, -12.6],
				"size": [7, 2.4],
				"text_size": 2.1,
				"font": "Soviet7SegmentFont SDF",
				"color": [0.42, 1, 0.38, 1],
				"value": "0000"
			},
			{
				"readout": "hf",
				"at": [-5.6, -12.6],
				"size": [7, 2.4],
				"text_size": 2.1,
				"font": "LiberationSans SDF",
				"color": [0.42, 1, 0.38, 1],
				"value": "HF"
			},
			{"seg": [0.4, -13.7, 0.4, -11.5], "w": 0.18, "color": [0.42, 1, 0.38, 1]},
			{"seg": [0.4, -11.4, -0.15, -12.15], "w": 0.18, "color": [0.42, 1, 0.38, 1]},
			{"seg": [0.4, -11.4, 0.95, -12.15], "w": 0.18, "color": [0.42, 1, 0.38, 1]},
			{"seg": [4.3, -11.4, 6.5, -11.4], "w": 0.15, "color": [0.42, 1, 0.38, 1]},
			{"seg": [4.3, -13.8, 6.5, -13.8], "w": 0.15, "color": [0.42, 1, 0.38, 1]},
			{"seg": [4.3, -11.4, 4.3, -13.8], "w": 0.15, "color": [0.42, 1, 0.38, 1]},
			{"seg": [6.5, -11.4, 6.5, -13.8], "w": 0.15, "color": [0.42, 1, 0.38, 1]},
			{
				"readout": "ammo",
				"at": [5.4, -12.6],
				"size": [2.2, 2.4],
				"text_size": 2.1,
				"font": "LiberationSans SDF",
				"color": [0.42, 1, 0.38, 1],
				"value": "F"
			},
			{"rect": "ready", "at": [8.6, -12.4], "size": [1.8, 1.8], "color": [0.42, 1, 0.38, 1]}
		]
	}
}
